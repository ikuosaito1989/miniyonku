{
  "name": "tiny-drive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "audio:pack": "tsx scripts/pack-music.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test src/game/*.test.ts",
    "preview:worker": "pnpm build && wrangler dev --port 8787",
    "deploy:check": "pnpm build && wrangler deploy --dry-run",
    "deploy:preview": "pnpm build && wrangler preview --name preview",
    "cf:types": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.151.1"
  }
}
