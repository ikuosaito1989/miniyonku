{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiningscorpion",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": true,
  "previews": {},
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
